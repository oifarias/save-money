// Schema do banco de dados do Save Money
// Cobre os módulos da V1 (autenticação, lançamentos, grupos/hashtags, contas)
// Campos de V2 (metas, orçamentos, assinaturas, notificações) já modelados para evolução futura

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum Recurrence {
  NONE
  WEEKLY
  MONTHLY
}

enum WishStatus {
  ACTIVE
  PURCHASED
  ABANDONED
}

enum WishKind {
  NEED
  WANT
}

enum WishPurchaseTiming {
  THIS_MONTH
  NEXT_MONTH
  LATER
}

enum WishPaymentMethod {
  CASH
  INSTALLMENTS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  // null para usuários que só fizeram login via OAuth (ex.: Google)
  currency     String   @default("BRL")
  theme        String   @default("system") // "light" | "dark" | "system"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // true logo após um login Google ser vinculado automaticamente a uma conta local existente
  // com o mesmo e-mail; consumido (e resetado) uma única vez para disparar o aviso ao usuário.
  pendingLinkNotice Boolean @default(false)

  // Incrementado a cada logout (ver events.signOut em src/lib/auth.ts). Sessões JWT emitidas
  // antes do incremento carregam a versão antiga e são derrubadas na checagem em (app)/layout.tsx,
  // já que a estratégia "jwt" não tem revogação nativa no servidor.
  tokenVersion Int @default(0)

  accounts        FinancialAccount[]
  oauthAccounts   Account[]
  sessions        Session[]
  transactions Transaction[]
  categories   Category[]
  tags         Tag[]
  budgets      Budget[]
  goals        Goal[]
  subscriptions Subscription[]
  notifications Notification[]
  fixedExpenseInsightDecisions FixedExpenseInsightDecision[]
  budgetIncomes BudgetIncome[]
  sharedSplits  SharedSplit[]
  installmentPlans InstallmentPlan[]
  fixedExpenseTemplates FixedExpenseTemplate[]
  wishes Wish[]
  creditCards  CreditCard[]
  savedVisualizations SavedVisualization[]

  @@map("users")
}

model FinancialAccount {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("wallet") // wallet, checking, savings, credit_card...
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

// Modelos padrão do Auth.js (NextAuth) usados para login OAuth (ex.: Google) e sessões em banco.
// Nomes de modelo fixos exigidos pelo @auth/prisma-adapter — só o nome da tabela física é
// customizável via @@map, para não colidir com `FinancialAccount` (mapeada para "accounts").
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  color     String   @default("#1A9E6F")
  icon      String   @default("Wallet")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[] @relation("TransactionCategory")
  subTransactions Transaction[] @relation("TransactionSubcategory")
  budgets      Budget[]
  goals        Goal[]
  fixedExpenseTemplates    FixedExpenseTemplate[] @relation("FixedExpenseTemplateCategory")
  fixedExpenseSubtemplates FixedExpenseTemplate[] @relation("FixedExpenseTemplateSubcategory")
  wishes Wish[] @relation("WishCategory")
  subWishes Wish[] @relation("WishSubcategory")

  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  accountId     String
  categoryId    String?
  subcategoryId String?
  type          TransactionType
  amount        Float
  date          DateTime
  description   String
  isFixed       Boolean         @default(false)
  recurrence    Recurrence      @default(NONE)
  installmentPlanId String?
  installmentNumber  Int?
  fixedExpenseTemplateId String?
  creditCardId  String?
  referenceMonth    String?         // formato "YYYY-MM" — preenchido SÓ quando a transação foi gerada via "marcar como pago" da checklist de despesa fixa; fica null para lançamentos normais, inclusive despesas fixas lançadas manualmente
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?        @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Category?        @relation("TransactionSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  fixedExpenseTemplate FixedExpenseTemplate? @relation(fields: [fixedExpenseTemplateId], references: [id], onDelete: SetNull)
  creditCard    CreditCard?       @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  tags        TransactionTag[]
  purchasedWish Wish?

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, type, date])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([installmentPlanId])
  @@index([fixedExpenseTemplateId])
  @@index([creditCardId])
  // `referenceMonth` só é preenchido quando a transação vem da checklist de despesa fixa; nesse caso,
  // garantimos no máximo um pagamento por template/mês. Para as demais transações (fixedExpenseTemplateId
  // e referenceMonth ambos null), o Postgres NÃO considera NULLs iguais entre si em unique constraints,
  // então múltiplas linhas com ambos null coexistem livremente — esse é o comportamento desejado.
  @@unique([fixedExpenseTemplateId, referenceMonth])
  @@map("transactions")
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  month       String   // formato "YYYY-MM"
  limitAmount Float
  bucket      String?  // "necessidade" | "desejo" — classificação usada na tela de Metas de Gastos
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  categoryId    String?
  wishId        String?   @unique
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  createdAt     DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  wish     Wish?     @relation(fields: [wishId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("goals")
}

model Wish {
  id              String     @id @default(cuid())
  userId          String
  name            String
  estimatedAmount Float
  categoryId      String              // obrigatório — requisito explícito do usuário
  subcategoryId   String              // obrigatório — requisito explícito do usuário
  status          WishStatus @default(ACTIVE)
  priority        Int        @default(0) // ordem de prioridade entre os desejos ACTIVE do usuário
  link            String?
  kind            WishKind           @default(WANT) // necessidade x desejo, granularidade do item (distinto do Budget.bucket, que é por categoria)
  purchaseTiming  WishPurchaseTiming @default(THIS_MONTH)
  paymentMethod   WishPaymentMethod  @default(CASH)
  installmentsCount Int?             // só relevante quando paymentMethod = INSTALLMENTS
  installmentAmount Float?           // só relevante quando paymentMethod = INSTALLMENTS — estimativa informativa, não cria InstallmentPlan até a compra ser confirmada
  notes           String?
  imageUrl        String?
  purchasedAt     DateTime?
  purchasedTransactionId String? @unique
  abandonedAt     DateTime?
  abandonReason   String?             // texto livre opcional, sem categorização — copy neutra, sem culpa
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category     @relation("WishCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Category     @relation("WishSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  purchasedTransaction Transaction? @relation(fields: [purchasedTransactionId], references: [id], onDelete: SetNull)
  goal        Goal?

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, createdAt])
  @@index([categoryId])
  @@index([subcategoryId])
  @@map("wishes")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Float
  dueDay    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model FixedExpenseInsightDecision {
  id             String   @id @default(cuid())
  userId         String
  groupKey       String
  status         String   // "accepted" | "dismissed"
  description    String
  amount         Float?
  categoryId     String?
  subcategoryId  String?
  transactionIds String[]
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupKey])
  @@map("fixed_expense_insight_decisions")
}

model BudgetIncome {
  id        String   @id @default(cuid())
  userId    String
  month     String   // "YYYY-MM"
  amount    Float
  source    String   // "average_3_months" | "manual" | "copied_previous_month"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("budget_incomes")
}

model InstallmentPlan {
  id                String   @id @default(cuid())
  userId            String
  baseDescription   String              // descrição sem o "(x/y)", ex: "Notebook"
  totalInstallments Int
  estimatedAmount   Float               // estimativa para projeção; NÃO é fonte de verdade do valor pago
  startDate         DateTime            // data projetada da parcela 1
  categoryId        String?
  subcategoryId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, baseDescription, totalInstallments])
  @@index([userId, categoryId])
  @@map("installment_plans")
}

model FixedExpenseTemplate {
  id             String   @id @default(cuid())
  userId         String
  description    String
  expectedAmount Float
  dueDay         Int      // dia do mês (1-31), derivado da data do lançamento que originou o template
  categoryId     String?
  subcategoryId  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation("FixedExpenseTemplateCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory  Category?     @relation("FixedExpenseTemplateSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, isActive])
  @@index([categoryId])
  @@index([subcategoryId])
  @@map("fixed_expense_templates")
}

model SharedSplit {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  title     String
  mode      String   // "equal" | "custom"
  createdAt DateTime @default(now())

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        SharedSplitItem[]
  participants SharedSplitParticipant[]

  @@index([userId])
  @@map("shared_splits")
}

model SharedSplitItem {
  id            String   @id @default(cuid())
  sharedSplitId String
  description   String
  amount        Float
  date          DateTime
  note          String?

  sharedSplit SharedSplit            @relation(fields: [sharedSplitId], references: [id], onDelete: Cascade)
  shares      SharedSplitItemShare[]

  @@index([sharedSplitId])
  @@map("shared_split_items")
}

model SharedSplitParticipant {
  id            String @id @default(cuid())
  sharedSplitId String
  name          String
  amount        Float
  position      Int

  sharedSplit SharedSplit            @relation(fields: [sharedSplitId], references: [id], onDelete: Cascade)
  shares      SharedSplitItemShare[]

  @@index([sharedSplitId])
  @@map("shared_split_participants")
}

// Valor que uma pessoa paga de um lançamento específico dentro de uma divisão em modo "custom".
// Só existe quando mode === "custom": no modo "equal" o valor por pessoa é uniforme e calculado
// direto a partir do total, sem necessidade de granularidade por item.
model SharedSplitItemShare {
  id                       String @id @default(cuid())
  sharedSplitItemId        String
  sharedSplitParticipantId String
  amount                   Float

  item        SharedSplitItem        @relation(fields: [sharedSplitItemId], references: [id], onDelete: Cascade)
  participant SharedSplitParticipant @relation(fields: [sharedSplitParticipantId], references: [id], onDelete: Cascade)

  @@unique([sharedSplitItemId, sharedSplitParticipantId])
  @@index([sharedSplitParticipantId])
  @@map("shared_split_item_shares")
}

model CreditCard {
  id        String   @id @default(cuid())
  userId    String
  bankCode  String   // "btg" | "itau" | "bradesco" | "santander" | "nubank" | "neon" | "inter" | "c6"
  nickname  String?
  limit     Float
  dueDay    Int      // dia de vencimento 1-28
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("credit_cards")
}

model SavedVisualization {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  filters     Json
  chartType   String
  groupBy     String
  displayOpts Json     @default("{}")
  shareToken  String?  @unique
  shareActive Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_visualizations")
}
