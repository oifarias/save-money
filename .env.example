# Banco de dados (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/save_money"

# Auth.js (NextAuth) — necessário para assinar sessões/JWTs
AUTH_SECRET="gere com: npx auth secret"

# Login com Google — criar credenciais OAuth em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <sua-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
